rules_version = '2';
// Planet Bonk 순위표 규칙 — Firebase 콘솔 → Firestore → 규칙 탭에 그대로 붙여 넣기
// - 누구나 순위표를 볼 수 있음
// - 자기 기록(익명 로그인 아이디와 같은 문서)만 쓸 수 있음
// - 점수는 올라갈 때만 바꿀 수 있음 (이름만 바꾸는 건 허용)
// - 레벨에 비해 말이 안 되는 점수는 거부 (레벨 L에 닿으려면 최소 4·L·(L-1)/2점이 필요)
service cloud.firestore {
  match /databases/{db}/documents {
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow create: if mine(uid) && validBoard(board) && valid(request.resource.data);
      allow update: if mine(uid) && validBoard(board) && valid(request.resource.data)
        && (request.resource.data.score > resource.data.score
            || (request.resource.data.score == resource.data.score
                && request.resource.data.level == resource.data.level));
      allow delete: if false;
    }

    function mine(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validBoard(board) {
      return board == 'all' || board.matches('^w[0-9]{4}-[0-9]{2}$');
    }
    function valid(d) {
      return d.keys().hasOnly(['name', 'score', 'level', 'ts'])
        && d.name is string && d.name.matches('^[A-Za-z0-9_]{3,12}$')
        && d.score is int && d.level is int
        && d.level >= 1 && d.level <= 1000
        && d.score >= 1 && d.score <= 1000000
        && d.score * 2 >= 4 * d.level * (d.level - 1)
        && d.score * 2 <= 4 * d.level * (d.level + 1) + 40 * d.level
        && d.ts == request.time;
    }
  }
}
